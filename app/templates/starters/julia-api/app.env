# How this app is built, started and stopped. Read by the verbs in this folder
# (build.sh, up.sh, down.sh) and by whatever drives them: Cove's buttons, an
# agent, a person at a shell. KEY=VALUE, sourceable by sh.
#
#   APP_LANGUAGE  julia | python | rust | r      what build.sh compiles
#   APP_KIND      port | module                  port: its own process on
#                                                127.0.0.1:APP_PORT; module:
#                                                module.r on the console pool
#   APP_PORT      the one port this app owns (no other domain's app uses it)
#   APP_HEALTH    path that answers 200 once the app is serving
APP_LANGUAGE=julia
APP_KIND=port
APP_PORT=__PORT__
APP_HEALTH=/health
# What it needs from the ndexr stack (language:package, module:name), each
# built on the n-boxes and published to every box (starters.rs needs).
APP_NEEDS="julia:HTTP julia:JSON julia:Distributions julia:GLM julia:OrdinaryDiffEq julia:StatsBase module:Julia"
